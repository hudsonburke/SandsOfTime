{{Read all absolute encoder positions via SPI into the EncCurPos list}}
pub ReadAbsEncoders() | i, value , EncoderNumber, CurrentPosition
  debug(`term term1 pos 200 20 size 25 12 textsize 24 color white)
  dirhigh(CLK)
  pinh(CLK)
  dirlow(DATA)
  repeat i from CS0 to CSf
    dirhigh(i)
    pinh(i)
  ' dirh(CSF..CS0) ' TODO
  'pinh(CSf..CS0)
  repeat
    repeat i from CS0 to CSf
      pinl(i) ' Chip Select
      waitus(1) ' Propeller 2 fast 2 furious
      pinl(CLK)
      waitus(1)
      value:=0
      repeat 16   ' Read 16 bits (top 10 are position)
        pinh(CLK)
        waitus(1)
        value := (value << 1) | pinr(DATA)
        pinl(CLK)
        waitus(1)
      CurrentPosition := value >> 6
      EncCurPos[i-CS0] := CurrentPosition
      EncoderNumber := i-CS0+1
      debug(`term1 'Encoder `(EncoderNumber) = `(CurrentPosition)', 10)
      pinh(CLK)
      waitus(1)
      pinh(i)
      waitus(1)
    waitms(200)
    debug(`term1 clear)


{Pin Helper Methods}
pri dirhigh(pin)
  if pin > 31
    dirb.[pin-32]~~
  else
    dira.[pin]~~

pri dirlow(pin)
  if pin > 31
    dirb.[pin-32]~
  else
    dira.[pin]~
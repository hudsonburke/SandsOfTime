{DS3234 RTC Clock Driver for Propeller 2}
{https://www.sparkfun.com/datasheets/BreakoutBoards/DS3234.pdf}

CON
  SS = 0     ' SPI Chip/Slave Select
  MOSI = 1   ' SPI Master Out / Slave In
  MISO = 2   ' SPI Master In / Slave Out
  SCLK = 3   ' SPI Clock
  SQW = -1   ' Optional Square Wave Interrupt Pin

  CPOL = 1 ' Clock Polarity. 0 = SCLK is low when idle, 1 = SCLK is high when idle

  Vcc = 5.0 ' Default Voltage. Setting this will change timing parameters for SPI communication

  t_DC_MIN = 30 'ns, Data to SCLK Setup
  t_CDH_MIN = 30 'ns, SCLK to Data Hold
  t_CCS_MIN = 30 'ns, SCLK to CS setup
  t_R_MAX = 200 'ns, SCLK Rise
  t_F_MAX = 200 'ns, SCLK Fall
  t_CC_MIN = 400 'ns, CS to SCLK Setup
  t_CWH_MIN = 400 'ns, CS Inactive Time
  t_CDZ_MAX = 40 'ns, CS to Output High Impedance

  { For 2.7 <= Vcc <= 5.5V }
  MAX_SPI_FREQ_5 = 4000000 ' 4MHz
  t_CDD_MAX_5 = 80 'ns, SCLK to Data Valid
  t_CL_MIN_5 = 110 'ns, SCLK Low Time
  t_CH_MIN_5 = 110 'ns, SCLK High Time
  t_CCH_MIN_5 = 100 'ns, SCLK to CS Hold

  { For 2.0 <= Vcc < 2.7V }
  MAX_SPI_FREQ_2 = 2000000 ' 2MHz
  t_CDD_MAX_2 = 160 'ns, SCLK to Data Valid
  t_CL_MIN_2 = 220 'ns, SCLK Low Time
  t_CH_MIN_2 = 220 'ns, SCLK High Time
  t_CCH_MIN_2 = 200 'ns, SCLK to CS Hold

  ' Chip register addresses
  #0, sec_r, min_r, hr_r, day_r, date_r, mo_cent_r, yr_r

  ' MSB determines read or write (0 - Read, 1 - Write)
  #$80, sec_w, min_w, hr_w, day_w, date_w, mo_cent_w, yr_w
  ' TODO: Add in Alarm and other things

var
  byte time_raw[7]
  word MAX_SPI_FREQ, t_CDD_MAX, t_CL_MIN, t_CH_MIN, t_CCH_MIN

pub null() ' Not a top level object

'*** Helper functions ***
pri waitns(ns) | count
  count := getct()
  waitct(clkfreq*ns/1_000_000_000 + count) ' TODO: This probably doesn't work for smaller values of ns and clkfreq

pri SPIStart(address) | i
  pinh(SS)
  ' TODO
  ' if CPOL == 0
  '   pinl(SCLK) ' Ensure clock starts low for CPOL = 0
  ' else
  pinh(SCLK) ' Ensure clock starts high for CPOL = 1
  pinl(SS)
  waitns(t_CCS_MIN)
  pinl(SCLK)
  waitns(t_CC_MIN)
  SPIWrite(address)

pri SPIEnd()
  pinh(SS)            ' Terminate the transaction
  waitns(t_CWH_MIN)   ' 400ns CS Inactive time between transfers

{{Read 1 byte via SPI into variable left shifted in; x should be address}}
pri SPIRead(x)
  repeat 8
    pinh(SCLK)
    waitns(t_CH_MIN)
    byte[x] := byte[x]<<1 | pinr(MISO)  ' Sends MSB first
    pinl(SCLK)
    waitns(t_CL_MIN)

{{Write 1 byte via SPI}}
pri SPIWrite(value) | i
  repeat i from 7 to 0
    pinw(MOSI, value>>i & 1)     ' Set MOSI bit; sends MSB first
    waitns(t_DC_MIN)             ' Wait for Data to SCLK setup time
    pinh(SCLK)                   ' Rising edge: RTC samples the data here
    waitns(t_CH_MIN)             ' Wait for minimum clock high time
    pinl(SCLK)                   ' Falling edge
    waitns(t_CL_MIN)             ' Wait for minimum clock low time

'*** Clock Functions ***

pub InitPins()
  'TODO: Add in checks and clamps for voltage
  if Vcc >= 2.7
    MAX_SPI_FREQ := MAX_SPI_FREQ_5
    t_CDD_MAX := t_CDD_MAX_5
    t_CL_MIN := t_CL_MIN_5
    t_CH_MIN := t_CH_MIN_5
    t_CCH_MIN := t_CCH_MIN_5
  else
    MAX_SPI_FREQ := MAX_SPI_FREQ_2
    t_CDD_MAX := t_CDD_MAX_2
    t_CL_MIN := t_CL_MIN_2
    t_CH_MIN := t_CH_MIN_2
    t_CCH_MIN := t_CCH_MIN_2

  pinf(MISO)
  pinl(MOSI)
  if CPOL == 0
    pinl(SCLK) ' Start clock low for CPOL = 0
  else
    pinh(SCLK) ' Start clock high for CPOL = 1
  pinh(SS)

  if SQW <> -1
    pinf(SQW)

{{Gets raw time data from registers seconds through year $00-$06}}
pub GetTime()  | i      ''Refresh time[0] through time[6] values
  SPIStart(sec_r)
  repeat i from 0 to 6
    SPIRead(@time_raw[i])
  SPIEnd()


pub SetTime12Hr(seconds, minutes, hours)
  SPIStart(sec_w)
  seconds := (seconds/10)<<4 + seconds+//10
  SPIWrite(seconds)
  minutes := (minutes/10)<<4 + minutes+//10
  SPIWrite(minutes)
  hours:= ((hours/10)|%0100)<<4 + hours+//10  ' assumes 12 hour
  SPIWrite(hours)
  SPIEnd()

{
{{TODO: Set seconds through year registers ($00-$06) using readable input parameters}}
pub SetDateAndTime(seconds, minutes, hours, AMorPM, day, date, month, year)
  SPIStart()
  SPIWrite(sec_w)
  seconds := seconds/10<<4 + seconds+//10
  SPIWrite(seconds)
  minutes := minutes/10<<4 + minutes+//10
  SPIWrite(minutes)
  if hours > 12
    hours := 0<<6 + hours/10<<4 + hours+//10
  if is24hour <> 0
    hours := 1<<6 + hours/10<<4 + hours+//10
  else

  SPIWrite(hours)
  SPIWrite(day)
  date := date/10<<4 + date+//10
  SPIWrite(date)
  month := month/10<<4 + month+//10
  SPIWrite(month)
  year := year/10<<4 + year+//10
  SPIWrite(year)
  SPIEnd()
}
{
pub SetSeconds(seconds)
  SPIStart()
  SPIWrite(sec_w)
  SPIWrite(seconds)
  SPIEnd()

pub SetMinutes(minutes)
  SPIStart()
  SPIWrite(min_w)
  SPIWrite(minutes)
  SPIEnd()

pub SetHours(hours)
  SPIStart()
  SPIWrite(hr_w)
  SPIWrite(hours)
  SPIEnd()

pub SetDay(day)
  SPIStart()
  SPIWrite(day_w)
  SPIWrite(day)
  SPIEnd()

pub SetDate(date)
  SPIStart()
  SPIWrite(date_w)
  SPIWrite(date)
  SPIEnd()

pub SetMonth(month) ' TODO: make it also do century?
  SPIStart()
  SPIWrite(mo_cent_w)
  SPIWrite(month)
  SPIEnd()

pub SetYear(year)
  SPIStart()
  SPIWrite(yr_w)
  SPIWrite(year)
  SPIEnd()
}
{{Returns time in readable format}}
pub ConvertToReadable() : sec, min, hr, dow, dte, mon, yr

  sec:=(time_raw[0]>>4)*10 + (time_raw[0] & $0f)                       'seconds
  min:=(time_raw[1]>>4)*10 + (time_raw[1] & $0f)                       'minutes
  hr:=(time_raw[2]>>4 & 1)*10 + (time_raw[2] & $0f) ' assumes 12 hour                    'hours TODO: Ignores AM/PM and potential 24 hours
  dow:=time_raw[3]                                                 'day of week
  dte:=(time_raw[4]>>4)*10 + (time_raw[4] & $0f)                       'date
  mon:=(time_raw[5] & $10)*10 + (time_raw[5] & $0f)                    'month
  yr:=(time_raw[5]>>7)*100 + (time_raw[6]>>4)*10 + (time_raw[6] & $0f)    'year
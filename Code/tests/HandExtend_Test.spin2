CON
  _clkfreq = 300_000_000

  numClockPulses = 10
  numBasePeriods = 1000

  {Limit Switch Pins}
  LSRetract = 38
  LSExtend = 37

  LSDebounceTime = 50 ' ms to wait after detecting a limit switch for it to stabilize and be read again

  {Quadrature Encoder Pins}
  ExtendEncTopPin = 35
  ExtendEncBotPin = 34

  ExtendEncTolerance = 30


  Extend_Kp = 5
  Extend_Ki = 0
  Extend_Kd = 0

OBJ
  hand_extend : "DRV8801"  | DIR=40, PWM=39, BRAKE=42, SLP=41, FAULT=-1, CS=-1, MinDuty=800

PUB TestHandExtend()

  {Initialize and retract motor}
  hand_extend.InitPins(numClockPulses, numBasePeriods)
  Retract(1000)
  pinstart(ExtendEncBotPin, p_quadrature + %0000<<28 + %0001<<24, 0, 0)
  repeat
    ExtendArm(2000)
    waitms(2000)
    Retract(1000)
    waitms(2000)

pub ExtendArm(set_pos) | error
  ' TODO: Add safety check to prevent pinching fingers
  repeat
    if pinr(LSExtend) == 1
      waitms(LSDebounceTime)
      if pinr(LSExtend) == 1
        quit
    error := set_pos - rdpin(ExtendEncBotPin)
    if abs(error) < ExtendEncTolerance
      quit
    hand_extend.Drive(error*Extend_Kp)
  hand_extend.Stop()

pub Retract(speed)
  ' Drive the arm backward until LSRetract reads 1
  if speed == 0
    speed := 1000
  hand_extend.DriveBackward(speed)
  repeat
    if pinr(LSRetract) == 1
      waitms(LSDebounceTime)
      if pinr(LSRetract) == 1
        quit
  hand_extend.Stop()


pri ClearQuadratureEncoder(bot_pin)
  pinfloat(bot_pin)
  pinlow(bot_pin)
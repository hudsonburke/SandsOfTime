CON
    'TODO: MEM stuff in Hourglass or WS2812B? may need to rearrange functions
    N_LEDS = 92    'Number of LEDs in the strip
    'Ring 1 - 32
    'Ring 2 - 24
    'Ring 3 - 16
    'Ring 4 - 12
    'Ring 5 - 8
    MEM_START = 0x0000
    MEM_SIZE = N_LEDS * 4  'Each LED uses 4 bytes (32 bits) of color data (G,R,B + unused byte)


VAR
    byte ring_index 'internal parameter, indicates which ring this LED object is controlling (1-12)
    byte minute_ring 'indicates which ring is currently representing the minute hand (1-12)
    byte hour_ring 'indicates which ring is currently representing the hour hand (1-12)
OBJ
  WS2812B : "WS2812B" 'LED driver object (for controlling the WS2812B LED strips)


CON

  maxaddress = 1_196             'For an 8x8 array, LEDs are addressed from 0-63 (increase this value if using arrays or strips with more LEDs)

 'Predefined colors                               green      red      blue
  off            = 0                            '%00000000_00000000_00000000
  red            = 255<<8                       '%00000000_11111111_00000000
  green          = 255<<16                      '%11111111_00000000_00000000
  blue           = 255                          '%00000000_00000000_11111111
  white          = 255<<16+255<<8+255           '%11111111_11111111_11111111
  cyan           = 255<<16+255                  '%11111111_00000000_11111111
  magenta        = 255<<8+255                   '%00000000_11111111_11111111
  yellow         = 255<<16+255<<8               '%11111111_11111111_00000000
  chartreuse     = 255<<16+127<<8               '%11111111_01111111_00000000
  orange         = 165<<16+255<<8               '%10100101_11111111_11010100
  aquamarine     = 255<<16+127<<8+212           '%11111111_01111111_11010100
  pink           = 192<<16+255<<8+203           '%11000000_11111111_11001011
  turquoise      = 224<<16+64<<8+192            '%11100000_01000000_11000000
  realwhite      = 255<<16+200<<8+255           '%11111111_11001000_11111111
  indigo         = 75<<8+130                    '%00000000_01001011_10000010
  violet         = 130<<16+238<<8+238           '%10000010_11101110_11101110

pub led(ring,LEDaddress,color)                            ''Changes the color of an LED at a specific address
  'TODO: make sure ring-1 is correct
  WS2812B.led((ring-1)*92+LEDaddress,color) 'Calculate the correct address for the LED based on its ring and position, and set it to the specified color
  'lights[(ring*92)+LEDaddress]:=color
  'Update()

PUB setMinuteRing(ring)
  minute_ring := ring

PUB setHourRing(ring)
  hour_ring := ring

PUB GetMinuteRing() : ring
  ring := minute_ring

PUB GetHourRing() : ring
  ring := hour_ring

PUB Intensity(color,intense) : newvalue              ''Changes the intensity (0-255) of a color
  intense := 0 #> intense <# 255                     ' Clamp intensity value to be between 0 and 255
  newvalue:=(
    (((color>>16)*intense)/255)<<16) + ...
    ((((color>>8 & $FF)*intense)/255)<<8) + ...
    (((color & $FF)*intense)/255
    )

PUB MakeColor(_red, _green, _blue, _intensity) : colorvalue  ''Creates a color value from red, green, and blue components (0-255)
  colorvalue := (_green<<16) + (_red<<8) + _blue
  colorvalue := Intensity(colorvalue, _intensity)

PUB RandomColor() : randcolor | rand,_red,_green,_blue,timer   ''Generates and returns a random color value
  rand:=getrnd()
  _red:=rand>>24
  rand:=getrnd()
  _green:=rand>>24
  rand:=getrnd()
  _blue:=rand>>24
  randcolor:=MakeColor(_red, _green, _blue, 255)

{Animations}
PUB idle_rings() | i_forward, ring_num
  'spirals non-active rings in and out
  'before minute - light blue
  'after minute - dark blue
  'not really sure what these next two lines are for?
  'pr0:=@lights                 'Store Hub RAM address of start of "lights" array as pr0 (which PASM can read)
  'pr1:=48                      'Specify first output pin as pr1 (which PASM can read)
  
  repeat i_forward from 0 to 91
    repeat ring_num from 1 to 12
      if ring_num == minute_ring or ring_num == hour_ring
        next
      if ring_num < minute_ring
        led(ring_num,i_forward,Intensity(cyan,30))
      else
        led(ring_num,i_forward,Intensity(blue,30))
    update()
    'waitus(5)


'old animation code
pub PulseWhite(wait_time) | i, j
  ' dim and brighten active ring with white color
  repeat i from 15 to 4
    longfill(@lights[MEM_START],Intensity(white,i),N_LEDS)
    waitms(wait_time)
  repeat j from 5 to 14
    longfill(@lights[MEM_START],Intensity(white,j),N_LEDS)
    waitms(wait_time)

pub FiveMinAnimation(wait_time) | i, frames
  'animates using preset frames (in DAT section) for active minute ring
  wait_time:=23077             '23077 for 5 min timer
  frames = [@Frame1, @Frame2, @Frame3, @Frame4, @Frame5, @Frame6, @Frame7, @Frame8, @Frame9, @Frame10, @Frame11, @Frame12, @Frame13, @Frame14]
  repeat i from 1 to 14
    longfill(@lights[MEM_START],@frames[i-1],N_LEDS)
    waitms(wait_time)


var
  long lights[1_196]     'Create an array of 1,196 longs to hold the color values of each LED in 92*13=1196

pub spin_all_but_active(color,power) | ring,i,j,k
  ' spin rings in animation, but skip the active rings (hour and minute)
  pr0:=@lights                 'Store Hub RAM address of start of "lights" array as pr0 (which PASM can read)
  pr1:=48
  repeat
    repeat j from 0 to 91 'j - index of each led in the ring
      repeat ring from 0 to 11 'ring - index of each ring
        if ring == minute_ring-1 or ring == hour_ring-1 'skip the active rings
          next
        repeat k from 0 to j 'k - index for how many leds to light up in the current ring
          led(ring,k,Intensity(color,power))
      update()

    ' reverse reverse!
    repeat j from 91 to 0
      repeat ring from 0 to 11
        if ring == minute_ring-1 or ring == hour_ring-1
          next
        led(ring,j,0) ' turn off
      update()

pub HourAnimation() | prev_ring
  ' animation for ring representing the hour
  ' either pulse white 
  ' or outside ring pulses while inner ring does minute animation
  pr0:=@lights                 'Store Hub RAM address of start of "lights" array as pr0 (which PASM can read)
  pr1:=48                      'Specify first output pin as pr1 (which PASM can read)

  repeat
    if hour_ring == minute_ring
      MinuteOnHourAnimation(hour_ring)
    else
      PulseWhite(hour_ring)
      repeat while hour_ring == prev_ring '
        prev_ring := hour_ring



pub MinuteAnimation() | prev_ring
  ' minute ring animation
  ' lasts five minutes
  ' unless minute and hour are the same; separate animation controlled by HourAnimation()
  pr0:=@lights                 'Store Hub RAM address of start of "lights" array as pr0 (which PASM can read)
  pr1:=48                      'Specify first output pin as pr1 (which PASM can read)
  repeat
    if (hour_ring <> minute_ring) and (minute_ring <> -1)
      FiveMinAnimation(minute_ring)


pub MinuteOnHourAnimation(ring) | waitbetween
  ' pulse outer ring
  ' innter ring does five minute animation
  waitbetween:=200             '23077 for 5 min timer
  RingedFrame(ring, @Frame1, 15)
  waitms(waitbetween)
  RingedFrame(ring, @Frame2, 13)
  waitms(waitbetween)
  RingedFrame(ring, @Frame3, 11)
  waitms(waitbetween)
  RingedFrame(ring, @Frame4, 9)
  waitms(waitbetween)
  RingedFrame(ring, @Frame5, 7)
  waitms(waitbetween)
  RingedFrame(ring, @Frame6, 5)
  waitms(waitbetween)
  RingedFrame(ring, @Frame7, 4)
  waitms(waitbetween)
  RingedFrame(ring, @Frame8, 3)
  waitms(waitbetween)
  RingedFrame(ring, @Frame9, 4)
  waitms(waitbetween)
  RingedFrame(ring, @Frame10, 5)
  waitms(waitbetween)
  RingedFrame(ring, @Frame11, 7)
  waitms(waitbetween)
  RingedFrame(ring, @Frame12, 9)
  waitms(waitbetween)
  RingedFrame(ring, @Frame13, 11)
  waitms(waitbetween)
  RingedFrame(ring, @Frame14, 13)

pub RingedFrame(ring, customData, whiteIntensity)
  ' ring: which ring to animate (1-12)
  ' customData: which frame to use for the animation (stored in DAT section)
  ' whiteIntensity: how bright to make the white color for the outer ring
  longmove(@lights[(ring-1)*92], customdata, 92) ' inner 4 rings
  longfill(@lights[(ring-1)*92], Intensity(white,whiteintensity), 56) ' outer 2 rings white

pub spin_bounce(ring,color,power) | i,j,k

  repeat i from 0 to 91
    repeat k from 0 to i
      led(ring,i,Intensity(color,power))
    update()
    waitus(5)

  repeat j from 0 to 91
    led(ring,j,0)
    update()
    waitus(5)

  repeat k from 0 to 2
    section(ring,0,91,Intensity(color,power))
    update()
    waitms(250)
    section(ring,0,91,0)
    update()
    waitms(250)
  section(ring,0,91,Intensity(color,power))


pub spin_all_but_active_random(power) | ring,i,j,k
  pr0:=@lights                 'Store Hub RAM address of start of "lights" array as pr0 (which PASM can read)
  pr1:=48
  {longfill(@lights,Intensity(blue,30),1_196)
  Update()
  repeat}
  repeat

    repeat j from 0 to 91
      repeat ring from 0 to 11
        if ring == minute_ring-1 or ring == hour_ring-1
          next
        repeat k from 0 to j
          led(ring,k,Intensity(randomcolor(),power))
      update()
    repeat ring from 0 to 11
      if ring == minute_ring-1 or ring == hour_ring-1
        next
      repeat j from 0 to 91
        led(ring,j,0)
      update()
      waitus(5)
      update()

pub spin_all(color,power) | ring,i,j,k


  repeat j from 0 to 91
    repeat ring from 0 to 11
      repeat k from 0 to j
        led(ring,k,Intensity(color,power))
    update()

  repeat ring from 0 to 11
     repeat j from 0 to 91
       led(ring,j,0)
    update()
    waitus(5)
    update()


pub spin_down(ring,color)| i
  section(ring,0,91,Intensity(color,125))
  repeat i from 0 to 91
    led(ring,i,0)
    waitus(3260869)    

